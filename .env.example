# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Upload Settings
MAX_CONTENT_LENGTH=52428800  # 50MB
UPLOAD_FOLDER=uploads
OUTPUT_FOLDER=output_videos

# Video Generation
VIDEO_DURATION=180  # 3 minutes in seconds
VIDEO_FPS=24
VIDEO_WIDTH=1280
VIDEO_HEIGHT=720

# TTS Settings
TTS_VOICE=zh-CN-XiaoxiaoNeural  # Female voice in Chinese
TTS_RATE=0.9  # Speech rate

# Subtitle Settings
SUBTITLE_FONT_SIZE=32
SUBTITLE_COLOR=ffffff

# Server
HOST=0.0.0.0
PORT=5000